            {
              "name": "Participante",
              "item": [
                {
                  "name": "Entrar em uma liga como participante",
                  "event": [
                    {
                      "listen": "prerequest",
                      "script": {
                        "type": "text/javascript",
                        "exec": [
                          "const baseUrl = pm.collectionVariables.get(\"baseUrl\");\r\nconst token = pm.collectionVariables.get(\"bearerToken\");\r\nconst idUsuario = pm.collectionVariables.get(\"idUsuario\");\r\n\r\nconst ListarLigasRequest = {\r\n    url: `${baseUrl}/api/leagues`,\r\n    method: \"GET\",\r\n    header: {\r\n        \"Content-Type\": \"application/json\",\r\n        \"Authorization\": `Bearer ${token}`\r\n    }\r\n};\r\n\r\nawait pm.sendRequest(ListarLigasRequest, (error, response) => {\r\n    if (error) {\r\n        throw new Error(`Falha ao listar ligas: ${error}`);\r\n    }\r\n\r\n    const ligas = response.json();\r\n    const ligaEncontrada = ligas.find(\r\n        liga => liga.status == \"aguardando_participantes\"\r\n            && !liga.participants.some(participante =>\r\n                participante._id === idUsuario\r\n            )\r\n    );\r\n\r\n    if (!ligaEncontrada) {\r\n        throw new Error(\"Nenhuma liga encontrada disponível para inscrever-se.\");\r\n    }\r\n\r\n    pm.collectionVariables.set(\"idLiga\", ligaEncontrada._id);\r\n});"
                        ]
                      }
                    },
                    {
                      "listen": "test",
                      "script": {
                        "type": "text/javascript",
                        "exec": [
                          "pm.test(\"Deve retornar status 200\", () => pm.response.to.have.status(200));"
                        ]
                      }
                    }
                  ],
                  "request": {
                    "auth": {
                      "type": "bearer",
                      "bearer": [
                        {
                          "key": "token",
                          "value": "{{bearerToken}}",
                          "type": "string"
