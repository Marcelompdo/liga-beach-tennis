                {
                  "name": "Sortear grupos de uma liga",
                  "event": [
                    {
                      "listen": "prerequest",
                      "script": {
                        "type": "text/javascript",
                        "exec": [
                          "const baseUrl = pm.collectionVariables.get(\"baseUrl\");\nconst token = pm.collectionVariables.get(\"bearerToken\");\n\nconst listarLigasRequest = {\n    url: `${baseUrl}/api/leagues`,\n    method: \"GET\",\n    header: {\n        \"Content-Type\": \"application/json\",\n        \"Authorization\": `Bearer ${token}`\n    }\n};\n\n// Promise-based call so the script waits for the response before the request is sent.\nconst response = await new Promise((resolve, reject) => {\n    pm.sendRequest(listarLigasRequest, (error, res) => {\n        if (error) {\n            return reject(new Error(`Falha ao listar ligas: ${error}`));\n        }\n        resolve(res);\n    });\n});\n\nif (response.code !== 200) {\n    throw new Error(`Falha ao listar ligas: status ${response.code}`);\n}\n\nconst ligas = response.json();\nconst ligaEncontrada = ligas.find(\n    liga => Array.isArray(liga.participants)\n        && liga.participants.length >= 4\n        && liga.status === \"aguardando_participantes\"\n);\n\nif (!ligaEncontrada) {\n    throw new Error(\"Nenhuma liga aguardando participantes com pelo menos 4 participantes.\");\n}\n\npm.collectionVariables.set(\"idLiga\", ligaEncontrada._id);"
                        ]
                      }
                    },
                    {
                      "listen": "test",
                      "script": {
                        "type": "text/javascript",
                        "exec": [
                          "pm.test(\"Deve retornar status 200\", () => {\r\n  pm.response.to.have.status(200);\r\n});"
                        ]
                      }
                    }
                  ],
                  "request": {
                    "auth": {
                      "type": "bearer",
                      "bearer": [
                        {
                          "key": "token",
                          "value": "{{bearerToken}}",
                          "type": "string"
                        }
                      ]
                    },
                    "method": "POST",
                    "header": [
                      {
                        "key": "Content-Type",
                        "value": "application/json"
                      },
                      {
                        "key": "Authorization",
                        "value": "Bearer {{token}}"
                      }
                    ],
                    "url": {
                      "raw": "{{baseUrl}}/api/leagues/{{idLiga}}/draw",
                      "host": [
                        "{{baseUrl}}"
                      ],
                      "path": [
                        "api",
                        "leagues",
                        "{{idLiga}}",
                        "draw"
                      ]
                    },
                    "description": "Requer no mínimo 4 participantes. Forma grupos de 4 sempre que possível e distribui os excedentes, mantendo diferença máxima de 1 integrante entre grupos."
                  },
                  "response": []
                }
              ],
              "event": [
                {
                  "listen": "prerequest",
                  "script": {
                    "type": "text/javascript",
                    "exec": [
                      "const loginRequest = {\n    url: `${pm.collectionVariables.get(\"baseUrl\")}/api/auth/login`,\n    method: \"POST\",\n    header: {\n        \"Content-Type\": \"application/json\"\n    },\n    body: {\n        mode: \"raw\",\n        raw: JSON.stringify({\n            email: \"ana.organizadora@beachliga.com\",\n            password: \"Beach2026\"\n        })\n    }\n};\n\n// Promise-based call: the script only continues after the login response arrives,\n// so bearerToken is always refreshed before the request is sent.\nconst response = await new Promise((resolve, reject) => {\n    pm.sendRequest(loginRequest, (error, res) => {\n        if (error) {\n            return reject(new Error(`Falha ao chamar login: ${error}`));\n        }\n        resolve(res);\n    });\n});\n\nif (response.code !== 200) {\n    throw new Error(`Login do organizador falhou com status ${response.code}`);\n}\n\nconst body = response.json();\nif (typeof body.token !== \"string\" || body.token === \"\") {\n    throw new Error(\"A resposta de login deve conter token\");\n}\n\npm.variables.set(\"bearerToken\", body.token);"
                    ]
                  }
                }
              ]
